APP_NAME="نظام إدارة التوزيع"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# المساعد الذكي — «اسأل السيستم» ومسح الفواتير
# المزوّد: gemini (الطبقة المجانية، الافتراضي) أو anthropic
ERP_AI_ENABLED=true
ERP_AI_PROVIDER=gemini
# سيبهم فاضيين عشان ياخدوا الافتراضي بتاع المزوّد:
#   المحادثة  gemini-3.5-flash-lite  (~0.6 ثانية للنداء)
#   المسح     gemini-3.5-flash       (~14 ثانية، بس بيقرا خط اليد أحسن)
#   التوجيه   gemini-3.5-flash-lite  (تصنيف كلمة واحدة — الأخف دايمًا)
# ERP_AI_CHAT_MODEL=
# ERP_AI_VISION_MODEL=
# ERP_AI_ROUTING_MODEL=
ERP_AI_MAX_TOKENS=2048
ERP_AI_CHAT_RATE_LIMIT=20
ERP_AI_SCAN_RATE_LIMIT=6

# الموديل البديل لما الأساسي يتأخر أو يرجّع 503 أو 404.
#
# **لازم يكون موديل تاني غير الأساسي.** الموديل المزحوم هيرجّع 503 تاني،
# فبديل بنفس اسم الأساسي معناه إن مفيش بديل خالص — وده اللي حصل على
# السيرفر لما الاتنين كانوا gemini-3.5-flash-lite ووقعوا مع بعض.
#
# الافتراضي: gemini-3.1-flash-lite (جيل أقدم ومستقر) على جيميني،
# و claude-sonnet-5 على كلود. سيبه فاضي ياخد الافتراضي.
# ولو ظبّطّه بنفس الأساسي بالغلط، النظام بياخد بديل تاني وبيكتب تنبيه
# في اللوج.
# ERP_AI_FALLBACK_MODEL=
# الوقت بالثواني — المهلة لنداء واحد، والميزانية للطلب كله.
# لازم الميزانية تفضل تحت حد تنفيذ PHP على الاستضافة (حوالي 30).
# والتوجيه والإجابة بيتقاسموا نفس الميزانية.
ERP_AI_TIMEOUT=20
ERP_AI_BUDGET=25

# توجيه السؤال لمجاله: مهلة نداء التصنيف، وأقل وقت فاضل يستاهل ننفق
# منه عليه (أقل من كده بنروح على المجموعة الافتراضية على طول).
ERP_AI_ROUTING_TIMEOUT=6
ERP_AI_ROUTING_RESERVE=10
# عدد الأسئلة المقترحة في لوحة المحادثة
ERP_AI_STARTERS=6

# مفتاح المزوّد المستخدم — واحد بس حسب ERP_AI_PROVIDER
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ── التنبيهات ──────────────────────────────────────────────────────
# ميعاد ملخّص النواقص اليومي
ERP_DIGEST_AT=09:00

# الإيميل — صندوق Hostinger.
# من غير MAIL_FROM_ADDRESS القناة بتفضل مقفولة والنظام بيقول كده في
# شاشة إعدادات التنبيهات بدل ما يقول «اتبعت» وهو مااتبعتش.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=noreply@usi-eg.com
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@usi-eg.com
# MAIL_FROM_NAME="${APP_NAME}"

# إشعارات المتصفح — ولّدها بـ: php artisan erp:vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://erp.usi-eg.com

# واتساب — Meta Cloud API. القناة مقفولة لحد ما دول يتحطوا.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_LOW_STOCK=low_stock_alert
# WHATSAPP_TEMPLATE_DIGEST=daily_stock_digest
# قالب مشاركة مستند مع التاجر — 3 متغيّرات: الشركة، المستند، لينك الـ PDF
# WHATSAPP_TEMPLATE_DOCUMENT=document_share
# WHATSAPP_TEMPLATE_LANG=ar
